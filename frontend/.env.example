# Supply your PostgreSQL connection securely. Never commit real credentials.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/open_energy
# Exact public origin; set to your HTTPS deployment URL for secure session cookies.
SITE_URL=http://localhost:3000

# Optional email notifications (server-side only; set real values securely in Railway).
RESEND_API_KEY=
NOTIFICATION_FROM=
# Defaults to the company email when omitted.
NOTIFICATION_TO=abdelrahman.khater.elc@gmail.com
